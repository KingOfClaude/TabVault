{
  "manifest_version": 3,
  "name": "Tab Vault",
  "version": "1.1.0",
  "description": "Save, search, and restore browser sessions. Auto-saves, recovers closed windows, keeps tab groups.",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "permissions": ["tabs", "tabGroups", "storage", "unlimitedStorage", "alarms", "contextMenus"],
  "host_permissions": ["https://api64.ipify.org/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "Tab Vault", "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" } },
  "commands": {
    "save-all": { "suggested_key": { "default": "Alt+Shift+S" }, "description": "Save all windows as a session" }
  }
}
